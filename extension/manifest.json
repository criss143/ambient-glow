{
  "manifest_version": 3,
  "name": "Ambient Glow Everywhere",
  "short_name": "Ambient Glow",
  "version": "1.7.0",
  "description": "Luz ambiental (ambilight) alrededor de cualquier video en cualquier página. Dev @Itzcrissxit",
  "author": "@Itzcrissxit",
  "permissions": [
    "storage",
    "activeTab",
    "tabCapture",
    "offscreen",
    "favicon"
  ],
  "action": {
    "default_title": "Ambient Glow",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "defaults.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "fs-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}